*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/
.ipynb_checkpoints/

.vscode/
.claude/
.aws/
*.pem
*.key

docs/
data/
tests/
notebooks/
infrastructure/
*.log
tmp/
temp/
