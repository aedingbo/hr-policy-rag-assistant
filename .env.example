# .env.example — configuration template for Project 1
# (HR Policy & Benefits Knowledge Assistant)
#
# Copy this file to .env and fill in local values:
#   Copy-Item .env.example .env
# .env is excluded by .gitignore and must never be committed.
# Never put real credentials or AWS access keys in this file or in .env.

# --- Application ---

# Deployment environment name. Use "local" for development on this machine.
APP_ENV=local

# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Local PostgreSQL (Docker Compose, used from P1-02) ---

# Host where the local database container is reachable.
POSTGRES_HOST=localhost

# Port the database listens on (5432 is the PostgreSQL default).
POSTGRES_PORT=5432

# Name of the application database.
POSTGRES_DB=hr_policy_rag

# Local admin/bootstrap account created by the PostgreSQL image. It is a
# superuser and is used only for local setup and administration (creating
# roles and databases, enabling extensions, backups), never by the running
# application (superusers bypass row-level security). Separate non-superuser
# migration and application roles are created in P1-09.
POSTGRES_USER=hr_rag_admin

# Placeholder password for the local development database only.
# Replace it in your own .env. Never reuse it anywhere else.
POSTGRES_PASSWORD=change-me-local-only

# --- AWS ---

# AWS region for Bedrock and other services. Confirm that the chosen
# Claude and Titan models are available in this region before use.
AWS_REGION=us-east-1

# Name of a local AWS CLI profile (configured in your user-level AWS config,
# outside this repository). Credentials are resolved through this profile;
# no access keys belong in this file.
AWS_PROFILE=hr-rag-dev

# Bedrock model ID for answer generation (Claude). Left blank until the
# exact model version is selected from current AWS documentation.
BEDROCK_GENERATION_MODEL_ID=

# Bedrock model ID for embeddings (Amazon Titan Text Embeddings default).
# Left blank until the exact model version is selected.
BEDROCK_EMBEDDING_MODEL_ID=
